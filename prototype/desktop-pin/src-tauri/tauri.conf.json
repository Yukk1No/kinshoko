{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kinshoko Pin Prototype",
  "version": "0.0.0",
  "identifier": "dev.kinshoko.prototype.desktoppin",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kinshoko 钉图原型（PROTOTYPE）",
        "url": "index.html",
        "width": 1180,
        "height": 760
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
