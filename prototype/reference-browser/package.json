{
  "name": "kinshoko-reference-browser-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "library": "python scripts/build_library.py",
    "dev": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && python scripts/pack.py"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
