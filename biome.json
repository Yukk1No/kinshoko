{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.agents", "!.claude", "!src/bindings", "!src/ui/vendor", "!dist", "!design", "!docs"]
  },
  "formatter": {
    "includes": ["src/**", "scripts/**", "e2e/**", "!**/*.md"],
    "indentStyle": "space",
    "lineWidth": 120
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "preset": "none",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@tauri-apps/api/mocks": {
                "importNames": ["mockIPC"],
                "message": "测试用 src/test/backend.ts 的 fakeBackend 登记回答，不直接调 mockIPC（#520）。"
              }
            }
          }
        }
      }
    }
  },
  "css": {
    "linter": {
      "enabled": false
    }
  },
  "json": {
    "linter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["src/test/backend.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["e2e/**", "scripts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useHookAtTopLevel": "off"
          }
        }
      }
    }
  ]
}
